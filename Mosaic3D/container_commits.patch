+
+class MaskLanguageLitModule(LitModuleBase):
+    def __init__(
+        self,
+        net,
+        optimizer,
+        scheduler,
+        scheduler_interval: str,
+        clip_encoder: Dict,
+        compile: bool,
+        loss_cfg: Dict,
