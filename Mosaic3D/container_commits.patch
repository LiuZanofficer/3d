+                                block(
+                                    (
+                                        channels[s] * block.expansion
+                                        if (s > 0 or i > 0)
+                                        else channels[s]
+                                    ),
+                                    channels[s],
+                                    norm_fn=norm_fn,
+                                    indice_key=f"subm{s + 1}",
+                                ),
+                            )
+                            for i in range(layers[s])
